<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RSK Odessa — Управление строительством</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body class="bg-gray-100 font-sans min-h-screen">

    <!-- ЭКРАН АВТОРИЗАЦИИ -->
    <div id="auth-screen" class="fixed inset-0 bg-gray-900 flex items-center justify-center z-[100] p-4">
        <div class="bg-white rounded-xl shadow-2xl p-8 max-w-sm w-full">
            <div class="text-center mb-6">
                <div class="bg-[#15803d] w-16 h-16 rounded-2xl mx-auto flex items-center justify-center text-white text-2xl font-bold shadow-lg">R</div>
                <h2 class="text-xl font-bold text-gray-800 mt-4">RSK Odessa</h2>
                <p class="text-xs text-gray-500 mt-1">Управление строительством</p>
            </div>
            <form id="login-form" class="space-y-3">
                <input type="email" id="login-email" placeholder="Email" required class="w-full border rounded-lg p-3 text-sm outline-none focus:ring-2 focus:ring-[#15803d]">
                <input type="password" id="login-password" placeholder="Пароль" required class="w-full border rounded-lg p-3 text-sm outline-none focus:ring-2 focus:ring-[#15803d]">
                <button type="submit" id="login-btn" class="w-full bg-[#15803d] hover:bg-[#166534] text-white font-semibold py-3 rounded-lg text-sm transition">Войти</button>
            </form>
            <p id="login-error" class="text-red-500 text-xs mt-3 text-center hidden"></p>
        </div>
    </div>

    <header class="bg-[#15803d] text-white shadow-md border-b-4 border-[#16a34a]">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col sm:flex-row justify-between items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="bg-white p-1 rounded-lg shadow-sm flex items-center justify-center">
                    <img src="logo.png" alt="RSK Logo" class="h-9 w-auto object-contain" onerror="this.style.display='none'">
                </div>
                <div>
                    <h1 class="text-base font-bold tracking-wide leading-tight">RSK Odessa</h1>
                    <p class="text-[10px] text-emerald-100 tracking-wider uppercase">building & repair</p>
                </div>
            </div>
            <div class="flex flex-wrap gap-2 items-center">
                <button onclick="switchTab('projects')" id="btn-projects" class="px-3 py-2 bg-[#16a34a] rounded-lg text-xs sm:text-sm font-semibold transition shadow">🏗 Объекты (<span id="projects-badge">0</span>)</button>
                <button onclick="switchTab('employees')" id="btn-employees" class="px-3 py-2 bg-[#16a34a]/70 hover:bg-[#16a34a] rounded-lg text-xs sm:text-sm font-semibold transition shadow">👥 Сотрудники (<span id="employees-badge">0</span>)</button>
                <button onclick="switchTab('orders')" id="btn-orders" class="px-3 py-2 bg-[#16a34a]/70 hover:bg-[#16a34a] rounded-lg text-xs sm:text-sm font-semibold transition shadow">📦 Снабжение (<span id="orders-badge">0</span>)</button>
                <button onclick="switchTab('registry')" id="btn-registry" class="px-3 py-2 bg-[#16a34a]/70 hover:bg-[#16a34a] rounded-lg text-xs sm:text-sm font-semibold transition shadow">📊 Реестр</button>
                <button onclick="switchTab('new-order')" id="btn-new-order" class="px-3 py-2 bg-[#22c55e] hover:bg-[#15803d] text-white rounded-lg text-xs sm:text-sm font-semibold transition shadow">➕ Новая заявка</button>
                <button onclick="logout()" class="px-3 py-2 bg-red-600 hover:bg-red-700 rounded-lg text-xs sm:text-sm font-semibold transition shadow" title="Выйти">🚪</button>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto p-4 mt-2">

        <section id="tab-projects" class="space-y-4">
            <div class="flex justify-between items-center bg-white p-4 rounded-xl shadow-sm border-l-4 border-[#15803d]">
                <h2 class="text-lg font-bold text-gray-800">📋 Активные объекты</h2>
                <button onclick="openAddProjectModal()" class="bg-[#15803d] hover:bg-[#166534] text-white px-3 py-1.5 rounded-lg text-xs font-semibold shadow transition">➕ Добавить объект</button>
            </div>
            <div id="projects-container" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
        </section>

        <section id="tab-project-detail" class="hidden space-y-4">
            <div class="flex justify-between items-center bg-white p-4 rounded-xl shadow-sm border-l-4 border-[#15803d]">
                <button onclick="switchTab('projects')" class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1">← Назад к списку объектов</button>
                <button onclick="" id="card-proj-delete-btn" class="text-red-500 hover:text-red-700 text-xs font-semibold">🗑 Удалить объект</button>
            </div>

            <div class="bg-white rounded-xl shadow-md p-6 space-y-6 border-t-4 border-[#15803d]">
                <div class="border-b pb-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                    <h2 class="text-xl font-bold text-[#166534]" id="card-proj-title">🏗 Название объекта</h2>
                </div>

                <div class="flex flex-wrap gap-2 border-b pb-4">
                    <button onclick="switchProjectSubTab('info')" id="subbtn-info" class="px-3.5 py-2 bg-[#15803d] text-white rounded-lg text-xs font-semibold transition shadow">📌 Общая информация</button>
                    <button onclick="switchProjectSubTab('planfact')" id="subbtn-planfact" class="px-3.5 py-2 bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-lg text-xs font-semibold transition shadow">📊 План-факт</button>
                    <button onclick="switchProjectSubTab('files')" id="subbtn-files" class="px-3.5 py-2 bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-lg text-xs font-semibold transition shadow">📁 Файлы</button>
                    <button onclick="switchProjectSubTab('schedule')" id="subbtn-schedule" class="px-3.5 py-2 bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-lg text-xs font-semibold transition shadow">📅 График</button>
                </div>

                <div id="proj-subtab-info" class="space-y-4">
                    <div class="row mb-4 grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm border border-gray-200 rounded-xl bg-white p-4 h-full flex flex-col justify-center">
                                <div class="card-body space-y-1">
                                    <h5 class="card-title text-[#15803d] font-bold mb-3 flex items-center text-sm"><span class="mr-2 text-base">👨‍💼</span> Материально ответственное лицо</h5>
                                    <p class="mb-1 text-xs sm:text-sm"><strong>Должность:</strong> <span id="card-proj-position" class="text-gray-900 font-semibold">Прораб</span></p>
                                    <p class="mb-1 text-xs sm:text-sm"><strong>ФИО:</strong> <span id="card-proj-foreman" class="text-gray-900 font-semibold"></span></p>
                                    <p class="mb-0 text-xs sm:text-sm"><strong>Телефон:</strong> <a id="card-proj-phone-link" href="#" class="text-[#15803d] hover:underline font-semibold"></a></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm border border-gray-200 rounded-xl bg-white p-4 h-full flex flex-col justify-center">
                                <div class="card-body">
                                    <div id="card-proj-financial-alert" class="overflow-hidden rounded-lg border border-emerald-200 text-xs">
                                        <div class="bg-emerald-600 text-white font-bold px-3 py-2 flex justify-between items-center">
                                            <span>📊 Финансовые показатели</span>
                                            <span class="bg-emerald-700 px-2 py-0.5 rounded text-[11px]" id="tbl-smeta-total-badge">Смета: 0 грн</span>
                                        </div>
                                        <div class="divide-y divide-emerald-100 bg-emerald-50/50">
                                            <div class="flex justify-between items-center px-3 py-2">
                                                <span class="text-gray-600 font-medium">🛠 Работы (План / Факт):</span>
                                                <span class="font-bold text-gray-800" id="tbl-works-val">0 / 0 грн</span>
                                            </div>
                                            <div class="flex justify-between items-center px-3 py-2">
                                                <span class="text-gray-600 font-medium">📦 Материалы (План / Факт):</span>
                                                <span class="font-bold text-gray-800" id="tbl-materials-val">0 / 0 грн</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="task-manager-card bg-white border border-gray-200 rounded-xl p-5 shadow-sm space-y-4 mt-4">
                        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b pb-3">
                            <h3 class="text-base font-bold text-gray-800 flex items-center gap-2">📌 Задачи для прораба</h3>
                            <div class="text-[11px] text-gray-500 bg-emerald-50 text-[#15803d] px-2.5 py-1 rounded-lg border border-emerald-100">💡 Уведомления в Telegram/Viber и прикрепление фотоактов активны</div>
                        </div>
                        <div class="flex flex-wrap gap-2 items-center">
                            <input type="text" id="taskInput" placeholder="Описание задачи..." class="flex-[2] min-w-[220px] px-3 py-2 border border-gray-300 rounded-lg text-xs sm:text-sm outline-none focus:ring-2 focus:ring-[#15803d]">
                            <input type="date" id="taskDate" class="flex-1 min-w-[130px] px-3 py-2 border border-gray-300 rounded-lg text-xs sm:text-sm outline-none focus:ring-2 focus:ring-[#15803d]">
                            <select id="taskPriority" class="px-3 py-2 border border-gray-300 rounded-lg text-xs sm:text-sm bg-white outline-none focus:ring-2 focus:ring-[#15803d]">
                                <option value="urgent" class="text-red-600 font-bold">⚡ Срочно</option>
                                <option value="important">⭐ Важный</option>
                                <option value="normal" selected>Обычная</option>
                            </select>
                            <button onclick="addTask()" class="bg-[#198754] hover:bg-[#15803d] text-white border-none px-4 py-2 rounded-lg cursor-pointer font-semibold text-xs sm:text-sm transition shadow whitespace-nowrap">+ Поставить задачу</button>
                        </div>
                        <div id="taskList" class="flex flex-col gap-2 pt-2"></div>
                    </div>
                </div>

                <div id="proj-subtab-planfact" class="hidden space-y-4">
                    <div class="space-y-3">
                        <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">📁 Разделы сметы (План / Факт)</h3>
                        <div id="sections-container" class="space-y-3"></div>
                    </div>
                </div>

                <div id="proj-subtab-files" class="hidden space-y-4">
                    <div class="border-t pt-4 space-y-3">
                        <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">📊 Загрузка файла сметы (Excel)</h3>
                        <div class="p-4 bg-gray-50 rounded-xl border space-y-3">
                            <div id="estimate-empty-state" class="text-xs text-gray-500">Смета еще не загружена.</div>
                            <div id="estimate-file-info" class="hidden flex items-center justify-between bg-white p-3 rounded-lg border text-xs">
                                <div class="flex items-center gap-2 overflow-hidden">
                                    <span class="text-lg">📄</span>
                                    <div>
                                        <p class="font-bold text-gray-800 truncate" id="estimate-file-name">Название файла</p>
                                        <p class="text-[10px] text-gray-400" id="estimate-file-date">Дата загрузки</p>
                                    </div>
                                </div>
                                <div class="flex gap-2">
                                    <button onclick="viewEstimateFile()" class="bg-emerald-100 hover:bg-emerald-200 text-[#15803d] px-3 py-1.5 rounded-lg font-semibold transition">👁 Оригинал</button>
                                    <button onclick="deleteEstimateFile()" class="bg-red-50 hover:bg-red-100 text-red-500 px-2 py-1.5 rounded-lg transition">🗑</button>
                                </div>
                            </div>
                            <div class="flex flex-col sm:flex-row gap-2 pt-1">
                                <input type="file" id="estimate-file-input" accept=".xlsx, .xls" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-[#15803d] hover:file:bg-emerald-100 cursor-pointer border rounded-lg bg-white">
                                <button onclick="uploadAndParseEstimate()" class="bg-[#15803d] hover:bg-[#166534] text-white text-xs font-semibold px-4 py-2 rounded-lg transition shadow whitespace-nowrap">📤 Загрузить и разобрать</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="proj-subtab-schedule" class="hidden space-y-4">
                    <div class="p-6 bg-gray-50 rounded-xl border text-center space-y-2">
                        <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">📅 График производства работ</h3>
                        <p class="text-xs text-gray-500">Раздел в разработке.</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="tab-employees" class="hidden space-y-4">
            <div class="flex justify-between items-center bg-white p-4 rounded-xl shadow-sm border-l-4 border-[#15803d]">
                <h2 class="text-lg font-bold text-gray-800">👥 Управление сотрудниками</h2>
                <button onclick="openAddEmployeeModal()" class="bg-[#15803d] hover:bg-[#166534] text-white px-3 py-1.5 rounded-lg text-xs font-semibold shadow transition">➕ Добавить сотрудника</button>
            </div>
            <div id="employees-container" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
        </section>

        <section id="tab-orders" class="hidden bg-white rounded-xl shadow-md p-6 space-y-4 border-t-4 border-[#15803d]">
            <div class="flex justify-between items-center border-b pb-3">
                <h2 class="text-lg font-bold text-gray-800">📦 Контроль заявок на материалы</h2>
                <button onclick="clearOrders()" class="text-xs text-red-500 hover:underline">Очистить историю</button>
            </div>
            <div id="orders-container" class="space-y-3"></div>
        </section>

        <section id="tab-registry" class="hidden space-y-4">
            <div class="bg-white rounded-xl shadow-md p-4 border-l-4 border-[#15803d] flex flex-wrap gap-2 items-center justify-between">
                <h2 class="text-lg font-bold text-gray-800">📊 Сводные реестры</h2>
                <div class="flex flex-wrap gap-2">
                    <button onclick="switchRegistrySub('materials')" id="reg-btn-materials" class="px-3 py-1.5 bg-[#15803d] text-white rounded-lg text-xs font-semibold shadow transition">Реестр материалов</button>
                    <button onclick="switchRegistrySub('works')" id="reg-btn-works" class="px-3 py-1.5 bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-lg text-xs font-semibold shadow transition">Реестр работ</button>
                    <button onclick="switchRegistrySub('deliveries')" id="reg-btn-deliveries" class="px-3 py-1.5 bg-gray-200 text-gray-700 hover:bg-gray-300 rounded-lg text-xs font-semibold shadow transition">Реестр доставок</button>
                </div>
            </div>

            <div id="reg-sub-materials" class="bg-white rounded-xl shadow-md p-6 space-y-4 border-t-4 border-[#15803d]">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 border-b pb-3">
                    <div>
                        <h3 class="text-base font-bold text-gray-800">📦 Реестр закрытых материалов</h3>
                        <p class="text-xs text-gray-500">Нажмите на строку для просмотра карточки.</p>
                    </div>
                    <button onclick="exportMaterialsToExcel()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-4 py-2 rounded-lg shadow transition flex items-center gap-1">📥 Скачать в Excel</button>
                </div>

                <div class="overflow-x-auto border rounded-xl">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-gray-100 text-gray-700 uppercase border-b font-semibold">
                            <tr>
                                <th class="p-2.5">Дата</th>
                                <th class="p-2.5">Наименование</th>
                                <th class="p-2.5">Ед. изм.</th>
                                <th class="p-2.5">Кол-во</th>
                                <th class="p-2.5">Цена за ед.</th>
                                <th class="p-2.5">Сумма</th>
                                <th class="p-2.5">Статус оплаты</th>
                                <th class="p-2.5">Поставщик</th>
                                <th class="p-2.5">Объект</th>
                                <th class="p-2.5">Раздел</th>
                            </tr>
                            <tr class="bg-gray-50 border-t">
                                <th class="p-1.5"><select id="flt-date" onchange="renderMaterialsRegistry()" class="w-full border rounded p-1 text-[11px] font-normal bg-white outline-none"><option value="">Все</option></select></th>
                                <th class="p-1.5"></th>
                                <th class="p-1.5"></th>
                                <th class="p-1.5"></th>
                                <th class="p-1.5"></th>
                                <th class="p-1.5"></th>
                                <th class="p-1.5"><select id="flt-payment" onchange="renderMaterialsRegistry()" class="w-full border rounded p-1 text-[11px] font-normal bg-white outline-none"><option value="">Все</option><option value="Оплачено">Оплачено</option><option value="В долг">В долг</option></select></th>
                                <th class="p-1.5"><select id="flt-supplier" onchange="renderMaterialsRegistry()" class="w-full border rounded p-1 text-[11px] font-normal bg-white outline-none"><option value="">Все</option></select></th>
                                <th class="p-1.5"><select id="flt-proj" onchange="renderMaterialsRegistry()" class="w-full border rounded p-1 text-[11px] font-normal bg-white outline-none"><option value="">Все</option></select></th>
                                <th class="p-1.5"><select id="flt-sec" onchange="renderMaterialsRegistry()" class="w-full border rounded p-1 text-[11px] font-normal bg-white outline-none"><option value="">Все</option></select></th>
                            </tr>
                        </thead>
                        <tbody id="registry-materials-tbody" class="divide-y"></tbody>
                    </table>
                </div>
            </div>

            <div id="reg-sub-works" class="hidden bg-white rounded-xl shadow-md p-6 space-y-4 border-t-4 border-[#15803d]">
                <h3 class="text-base font-bold text-gray-800 border-b pb-3">🛠 Реестр работ</h3>
                <p class="text-xs text-gray-500">Раздел в разработке.</p>
            </div>

            <div id="reg-sub-deliveries" class="hidden bg-white rounded-xl shadow-md p-6 space-y-4 border-t-4 border-[#15803d]">
                <h3 class="text-base font-bold text-gray-800 border-b pb-3">🚚 Реестр доставок</h3>
                <p class="text-xs text-gray-500">Раздел в разработке.</p>
            </div>
        </section>

        <section id="tab-new-order" class="hidden bg-white rounded-xl shadow-md p-6 max-w-xl mx-auto space-y-4 border-t-4 border-[#15803d]">
            <h2 class="text-lg font-bold text-gray-800 border-b pb-3">📝 Оформление заявки на закупку</h2>
            <form onsubmit="submitMaterialOrder(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Объект:</label>
                    <select id="order-proj" onchange="onOrderProjectChange()" required class="w-full border rounded-lg p-2.5 text-sm bg-white outline-none focus:ring-2 focus:ring-[#15803d]"></select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Раздел / Этап:</label>
                    <select id="order-section" required class="w-full border rounded-lg p-2.5 text-sm bg-white outline-none focus:ring-2 focus:ring-[#15803d]"></select>
                </div>
                <div class="space-y-2 border-t border-b py-3">
                    <div class="flex justify-between items-center">
                        <label class="text-xs font-bold text-gray-700 uppercase tracking-wider">📦 Позиции материалов:</label>
                        <button type="button" onclick="addOrderItemRow()" class="text-xs bg-emerald-50 text-[#15803d] hover:bg-emerald-100 font-semibold px-2.5 py-1 rounded-lg transition">➕ Добавить позицию</button>
                    </div>
                    <div id="order-items-container" class="space-y-2"></div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Желаемая дата поставки:</label>
                    <input type="date" id="order-date" required class="w-full border rounded-lg p-2.5 text-sm outline-none focus:ring-2 focus:ring-[#15803d]">
                </div>
                <button type="submit" class="w-full bg-[#15803d] hover:bg-[#166534] text-white font-semibold py-2.5 rounded-lg text-sm transition shadow">✅ Отправить заявку в снабжение</button>
            </form>
        </section>

    </main>

    <div id="material-card-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-xl max-w-lg w-full p-6 space-y-4 border-t-4 border-[#15803d]">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="text-base font-bold text-gray-800 flex items-center gap-1.5"><span>📦</span> Карточка закупленного материала</h3>
                <button onclick="closeMaterialCardModal()" class="text-gray-400 hover:text-gray-600 font-bold text-lg">✕</button>
            </div>
            <div id="material-card-content" class="space-y-3 text-xs sm:text-sm"></div>
            <div class="pt-2 border-t flex justify-end">
                <button onclick="closeMaterialCardModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold px-4 py-2 rounded-lg text-xs transition">Закрыть</button>
            </div>
        </div>
    </div>

    <div id="close-order-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-lg max-w-2xl w-full p-6 space-y-4 border-t-4 border-[#15803d] max-h-[90vh] overflow-y-auto">
            <div class="flex justify-between items-center border-b pb-2">
                <h3 class="text-base font-bold text-gray-800">🛒 Закупка материала</h3>
                <button onclick="closeModalCloseOrder()" class="text-gray-400 hover:text-gray-600 font-bold text-lg">✕</button>
            </div>
            <form onsubmit="confirmOrderPurchase(event)" class="space-y-3">
                <input type="hidden" id="modal-order-id">
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider">💰 Стоимость и статус расчетов:</label>
                    <div id="modal-order-items-price-container" class="space-y-3 bg-gray-50 p-3 rounded-lg border"></div>
                </div>
                <div class="bg-emerald-50 p-3 rounded-lg border border-emerald-100 flex justify-between items-center">
                    <span class="text-xs font-bold text-[#15803d] uppercase">Итого:</span>
                    <span id="modal-order-total-sum-label" class="text-base font-bold text-[#166534]">0 грн</span>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Поставщик:</label>
                    <input type="text" id="modal-order-supplier" required placeholder="Эпицентр" class="w-full border rounded-lg p-2.5 text-sm outline-none focus:ring-2 focus:ring-[#15803d]">
                </div>
                <div class="flex gap-2 pt-2">
                    <button type="submit" class="flex-1 bg-[#15803d] hover:bg-[#166534] text-white font-semibold py-2.5 rounded-lg text-sm transition shadow">💾 Сохранить и закрыть</button>
                    <button type="button" onclick="closeModalCloseOrder()" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2.5 rounded-lg text-sm transition">Отмена</button>
                </div>
            </form>
        </div>
    </div>

    <div id="estimate-viewer-modal" class="hidden fixed inset-0 bg-black/70 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-2xl max-w-4xl w-full h-[85vh] flex flex-col overflow-hidden">
            <div class="bg-[#15803d] text-white px-4 py-3 flex justify-between items-center">
                <span class="font-bold text-sm truncate" id="modal-estimate-title">📄 Просмотр сметы</span>
                <div class="flex items-center gap-2">
                    <a id="modal-estimate-download" href="#" download class="bg-white text-[#15803d] px-3 py-1 rounded-lg text-xs font-semibold hover:bg-emerald-50 transition">Скачать</a>
                    <button onclick="closeEstimateModal()" class="text-white hover:text-gray-200 font-bold text-lg px-2">✕</button>
                </div>
            </div>
            <div class="flex-1 bg-gray-100 p-2 flex items-center justify-center overflow-hidden" id="modal-estimate-content"></div>
        </div>
    </div>

    <div id="project-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-lg max-w-md w-full p-6 space-y-4">
            <h3 class="text-lg font-bold text-gray-800">🏗 Добавить новый объект</h3>
            <form onsubmit="saveNewProject(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Название объекта:</label>
                    <input type="text" id="new-proj-name" required placeholder="Коттедж" class="w-full border rounded-lg p-2.5 text-sm outline-none focus:ring-2 focus:ring-[#15803d]">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Ответственный прораб:</label>
                    <select id="new-proj-foreman" required class="w-full border rounded-lg p-2.5 text-sm bg-white outline-none focus:ring-2 focus:ring-[#15803d]"></select>
                </div>
                <div class="flex gap-2 pt-2">
                    <button type="submit" class="flex-1 bg-[#15803d] hover:bg-[#166534] text-white font-semibold py-2 rounded-lg text-sm transition">Сохранить</button>
                    <button type="button" onclick="closeAddProjectModal()" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 rounded-lg text-sm transition">Отмена</button>
                </div>
            </form>
        </div>
    </div>

    <div id="employee-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-xl shadow-lg max-w-md w-full p-6 space-y-4">
            <form onsubmit="saveNewEmployee(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">ФИО сотрудника:</label>
                    <input type="text" id="emp-name" required placeholder="Иван Прорабов" class="w-full border rounded-lg p-2.5 text-sm outline-none focus:ring-2 focus:ring-[#15803d]">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Должность:</label>
                    <select id="emp-position" class="w-full border rounded-lg p-2.5 text-sm bg-white outline-none focus:ring-2 focus:ring-[#15803d]">
                        <option value="Директор">Директор</option>
                        <option value="Администратор">Администратор</option>
                        <option value="Главный инженер">Главный инженер</option>
                        <option value="Прораб">Прораб</option>
                        <option value="Снабженец">Снабженец</option>
                        <option value="Инженер ПТО">Инженер ПТО</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Телефон:</label>
                    <input type="tel" id="emp-phone" required placeholder="+38 (050) 000-00-00" class="w-full border rounded-lg p-2.5